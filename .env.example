# X app credentials (developer.x.com -> your app -> Keys and tokens).
# The access token must belong to the bot account and have Read + Write permission.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Handle of the account the bot replies to (no @)
TARGET_USERNAME=

# Optional
CONTENT_FILE=content.json
STATE_FILE=state.json
POLL_SECONDS=120
MAX_REPLIES_PER_DAY=10
DRY_RUN=true
